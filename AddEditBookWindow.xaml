<Window x:Class="LibraryApp.AddEditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книга" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#E8F5E9"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tbTitle" Text="Добавление книги" FontSize="18" FontWeight="Bold" 
                   Foreground="#2E7D32" Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <TextBlock Text="Название книги:" Grid.Row="1" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbTitleBook" Grid.Row="2" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Автор:" Grid.Row="3" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbAuthor" Grid.Row="4" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Жанр:" Grid.Row="5" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbGenre" Grid.Row="6" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Год издания:" Grid.Row="7" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbYear" Grid.Row="8" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Издательство:" Grid.Row="9" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbPublisher" Grid.Row="10" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Количество страниц:" Grid.Row="11" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbPages" Grid.Row="12" Height="35" Margin="0,0,0,10" Background="White"/>

        <TextBlock Text="Всего экземпляров:" Grid.Row="13" Margin="0,5" Foreground="#333333"/>
        <TextBox x:Name="tbCopiesTotal" Grid.Row="14" Height="35" Margin="0,0,0,20" Background="White"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="110" Height="40" 
                    Margin="0,0,15,0" Click="btnSave_Click"
                    Background="#28A745" Foreground="White" FontWeight="Bold" FontSize="14"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="110" Height="40" 
                    Click="btnCancel_Click"
                    Background="#6C757D" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>