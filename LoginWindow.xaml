<Window x:Class="LibraryApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E8F5E9">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📚 Библиотека" FontSize="22" FontWeight="Bold" 
                   Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин" FontSize="13" Foreground="#2E7D32" Margin="0,0,0,5"/>
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#4CAF50" BorderThickness="1">
            <TextBox x:Name="tbLogin" Height="40" BorderThickness="0" Padding="15,0" Background="Transparent"/>
        </Border>

        <TextBlock Grid.Row="3" Text="Пароль" FontSize="13" Foreground="#2E7D32" Margin="0,15,0,5"/>
        <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#4CAF50" BorderThickness="1">
            <PasswordBox x:Name="pbPassword" Height="40" BorderThickness="0" Padding="15,0" Background="Transparent"/>
        </Border>

        <TextBlock x:Name="tbError" Grid.Row="5" Text="" Foreground="#D32F2F" 
                   HorizontalAlignment="Center" Visibility="Collapsed" FontSize="12" Margin="0,10"/>

        <Button x:Name="btnLogin" Grid.Row="6" Content="ВОЙТИ" Height="45" FontSize="14"
                FontWeight="Bold" Click="btnLogin_Click" Margin="0,10,0,0"
                Background="#4CAF50" Foreground="White" Cursor="Hand"/>
    </Grid>
</Window>