<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МАУК Кушнаренковская МЦБС" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#E8F5E9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2E7D32" Padding="15">
            <TextBlock Text="📚 МАУК Кушнаренковская МЦБС" 
                       FontSize="20" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnOpenBooks" Content="📖 Книги" 
                    Width="250" Height="60" Click="btnOpenBooks_Click"
                    Background="#43A047" Foreground="White" FontWeight="Bold" FontSize="16"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#2E7D32" Padding="10">
            <TextBlock Text="© 2024 МАУК Кушнаренковская МЦБС - Все права защищены" 
                       Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>