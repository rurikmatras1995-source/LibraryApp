<Window x:Class="LibraryApp.BooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книги - МАУК Кушнаренковская МЦБС" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#E8F5E9">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📖 Список книг" FontSize="22" FontWeight="Bold" 
                   Foreground="#2E7D32" Margin="0,0,0,10"/>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="1" Background="#C8E6C9" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍 Поиск:" VerticalAlignment="Center" 
                           Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBox x:Name="tbSearch" Grid.Column="1" Height="30" 
                         TextChanged="tbSearch_TextChanged"
                         BorderBrush="#4CAF50" BorderThickness="1" Padding="8,0"
                         Background="White"/>

                <TextBlock Grid.Column="2" Text="Жанр:" VerticalAlignment="Center" 
                           Foreground="#2E7D32" FontWeight="Bold" Margin="10,0,8,0"/>
                <ComboBox x:Name="cbGenreFilter" Grid.Column="3" Height="30" 
                          SelectionChanged="cbGenreFilter_SelectionChanged"
                          BorderBrush="#4CAF50" BorderThickness="1" Background="White"/>

                <TextBlock Grid.Column="4" Text="Год:" VerticalAlignment="Center" 
                           Foreground="#2E7D32" FontWeight="Bold" Margin="10,0,8,0"/>
                <ComboBox x:Name="cbYearFilter" Grid.Column="5" Height="30" 
                          SelectionChanged="cbYearFilter_SelectionChanged"
                          BorderBrush="#4CAF50" BorderThickness="1" Background="White"/>

                <Button x:Name="btnClearFilter" Grid.Column="6" Content="Сброс" Width="80" Height="30" 
                        Margin="10,0,0,0" Click="btnClearFilter_Click"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Таблица книг -->
        <DataGrid x:Name="dgBooks" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single"
                  Background="White" BorderBrush="#4CAF50" BorderThickness="1"
                  AlternatingRowBackground="#E8F5E9" FontSize="13" RowHeight="40">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="40"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding book_id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding book_title}" Width="200"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding author}" Width="150"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding genre}" Width="120"/>
                <DataGridTextColumn Header="Год" Binding="{Binding year_of_publication}" Width="80"/>
                <DataGridTextColumn Header="Всего" Binding="{Binding copies_total}" Width="80"/>
                <DataGridTextColumn Header="Доступно" Binding="{Binding copies_available}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
            <Button x:Name="btnAdd" Content="➕ Добавить" Width="130" Height="35" 
                    Margin="0,0,10,0" Click="btnAdd_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать" Width="150" Height="35" 
                    Margin="0,0,10,0" Click="btnEdit_Click"
                    Background="#FFC107" Foreground="#333" FontWeight="Bold"/>
            <Button x:Name="btnDelete" Content="🗑️ Удалить" Width="120" Height="35" 
                    Margin="0,0,10,0" Click="btnDelete_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="130" Height="35" 
                    Margin="0,0,10,0" Click="btnRefresh_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnBack" Content="◀ На главную" Width="130" Height="35" 
                    Click="btnBack_Click"
                    Background="#6C757D" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>